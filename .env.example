# Copy to .env for local runs. Real values live in Venice's Secret Manager and
# are injected at deploy; never commit a filled-in .env.

# Required (service fails fast without these)
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
ANTHROPIC_API_KEY=sk-ant-...
SCHEDULER_SECRET=...

# Injected after handoffs (optional at boot)
GOOGLE_SHEET_ID=
ESCALATION_CHANNEL_ID=
ESCALATION_MENTION_IDS=

# Tunable
PORT=8080
ANTHROPIC_MODEL=claude-sonnet-4-6
CHECKIN_DAY=Monday
CHECKIN_HOUR_LOCAL=11
